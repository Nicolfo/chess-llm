{
  "name": "chess-llm",
  "version": "1.4.0",
  "description": "Play chess against LLMs",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.public.json"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@langfuse/otel": "^6.0.2",
    "@langfuse/tracing": "^6.0.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "stockfish": "19.0.1",
    "undici": "^7.30.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nicolfo/chess-llm.git"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
